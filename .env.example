# Local development environment — copy to .env and fill in real values.
# NEVER commit .env. See docs/LOCAL_SETUP.md for full setup instructions.

# PostgreSQL connection (local dev). Production will use Supabase (approval pending).
DATABASE_URL="postgresql://<user>:<password>@127.0.0.1:5432/ssconsultancy"

# Data mode for the public site data layer: "fixture" (local fixture data, no DB)
# or "database" (live PostgreSQL via Prisma). See docs/LOCAL_SETUP.md.
DATA_MODE="database"

# Admin session signing key (HMAC-SHA256). Generate with: openssl rand -hex 32
# Sessions are invalid after any change of this value.
AUTH_SECRET="<openssl rand -hex 32>"

# Property-image storage driver: "local" (filesystem, default) today;
# "vercel-blob" is wired when the client approves production infrastructure.
STORAGE_DRIVER="local"

# Local storage root for uploaded images (git-ignored), relative to the
# project directory. Only used when STORAGE_DRIVER=local.
IMAGE_STORAGE_DIR="storage/images"
